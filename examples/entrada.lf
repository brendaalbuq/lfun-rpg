-- Exemplo principal: combate simples
let forca : Int = 15;
fun dano : Int -> Int;
let dano n = n * 2;

fun estadoVida : Int -> String;
let estadoVida hp = if hp > 0 then "vivo" else "morto";

let hp : Int = 18;
let aposGolpe : Int = hp - dano(4);

forca;
dano(forca);
aposGolpe;
estadoVida(aposGolpe);
